# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Material original del cliente (3.7 GB) y artefactos de trabajo.
# Los derivados optimizados sí se versionan, en public/media y public/video.
/tmp/

# El ejemplo sí se versiona; los valores reales no.
!.env.example

# Posters intermedios generados por scripts/ (los usados son public/media/poster-*.webp)
public/video/.*.png
