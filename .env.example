# =============================================================================
#  Copiar a .env.local y completar. Todo es opcional: si falta algo, se usan
#  los valores por defecto de src/config/site.ts (placeholders).
# =============================================================================

# --- Sitio ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://aonami.pe"
NEXT_PUBLIC_LEGAL_NAME="Plenor S.A.C."
NEXT_PUBLIC_RUC="20000000000"

# --- Contacto público ----------------------------------------------------
NEXT_PUBLIC_PHONE="+51999999999"
NEXT_PUBLIC_PHONE_DISPLAY="+51 999 999 999"
NEXT_PUBLIC_WHATSAPP="51999999999"
NEXT_PUBLIC_EMAIL="ventas@plenor.pe"

NEXT_PUBLIC_INSTAGRAM="https://instagram.com/plenor.pe"
NEXT_PUBLIC_FACEBOOK="https://facebook.com/plenor.pe"
NEXT_PUBLIC_LINKEDIN="https://linkedin.com/company/plenor"

# --- Destinatarios de formularios (solo servidor) ------------------------
MAIL_LEADS_TO="ventas@plenor.pe"
MAIL_COMPLAINTS_TO="reclamaciones@plenor.pe"
MAIL_FROM="Residencial Aonami <no-reply@plenor.pe>"
MAIL_BCC=""

# =============================================================================
#  ENVÍO DE CORREO
#  Elegir UNO de los dos. Si no se configura ninguno, los formularios validan
#  y responden bien pero el correo NO se envía: queda registrado en el log del
#  servidor con el aviso correspondiente (útil en desarrollo).
# =============================================================================

# Opción A — Resend (recomendado). Requiere verificar el dominio en resend.com
RESEND_API_KEY=""

# Opción B — SMTP (Google Workspace, Zoho, cPanel, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
